# Real NestJS backend, including its global /api/v1 prefix.
# Local dev: http://localhost:9999/api/v1
# Production (Vercel): the backend's real public HTTPS URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:9999/api/v1

# LINE LIFF app ID (LINE Developers Console). Scope MUST include `openid`, or
# liff.getIDToken() always returns null and the customer join flow cannot authenticate.
NEXT_PUBLIC_LIFF_ID=

# Signs/encrypts the Auth.js admin session cookie. Generate your own — never reuse
# any value committed to a repo. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Backend Socket.io gateway origin (no path/prefix). Used for the realtime cart/order/
# bill push channel; the app falls back to polling if this is unset or unreachable.
# Local dev: http://localhost:9999
# Production: same host as NEXT_PUBLIC_API_BASE_URL, without the /api/v1 suffix.
NEXT_PUBLIC_SOCKET_URL=http://localhost:9999
